# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mydb
DB_USERNAME=user
DB_PASSWORD=password

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# JPA Configuration
JPA_SHOW_SQL=true
JPA_DDL_AUTO=update

# Error Handling
ERROR_INCLUDE_MESSAGE=always

# Application Name
APP_NAME=backend-api